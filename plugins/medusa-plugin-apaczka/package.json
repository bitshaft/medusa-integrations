{
  "name": "@bitshaft/medusa-plugin-apaczka",
  "version": "0.2.0",
  "description": "Apaczka.pl shipping for Medusa v2: 20+ Polish and international carriers, parcel lockers and pickup points, live rates, labels, COD, courier pickups, returns and webhook tracking.",
  "author": "Bitshaft (https://bitshaft.pl)",
  "license": "MIT",
  "homepage": "https://github.com/bitshaft/medusa-integrations/tree/main/plugins/medusa-plugin-apaczka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitshaft/medusa-integrations.git",
    "directory": "plugins/medusa-plugin-apaczka"
  },
  "bugs": {
    "url": "https://github.com/bitshaft/medusa-integrations/issues"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-shipping",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-fulfillment",
    "apaczka",
    "alsendo",
    "shipping",
    "fulfillment",
    "inpost",
    "paczkomat",
    "dpd",
    "dhl",
    "ups",
    "gls",
    "pocztex",
    "orlen-paczka",
    "poland"
  ],
  "files": [
    ".medusa/server",
    "!**/*.map",
    "!**/__tests__",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/apaczka/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/kit/strip-source-maps.mjs",
    "dev": "medusa plugin:develop",
    "publish:local": "medusa plugin:publish",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p src/admin/tsconfig.json && tsc --noEmit -p tsconfig.storefront.json",
    "test": "jest --selectProjects unit",
    "check": "npm run typecheck && npm test",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:sandbox": "jest --selectProjects sandbox",
    "test:coverage": "jest --selectProjects unit --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/eslint-plugin": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/icons": "2.22.3",
    "@medusajs/js-sdk": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@medusajs/ui": "4.2.10",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.22.0",
    "@medusajs/framework": "^2.22.0",
    "@medusajs/icons": "^2.22.0",
    "@medusajs/js-sdk": "^2.22.0",
    "@medusajs/medusa": "^2.22.0",
    "@medusajs/ui": "^4.2.0",
    "@tanstack/react-query": "^5.64.0",
    "react-router-dom": "^6.20.0 || ^7.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.19.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

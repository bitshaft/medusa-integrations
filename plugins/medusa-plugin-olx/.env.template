# Copy to .env and fill in. Never commit .env.
# From your app on https://developer.olx.pl
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Must equal the app's Redirect URI: https://<your-backend>/hooks/olx/oauth/callback
OLX_REDIRECT_URI=
# At least 32 random characters, e.g. from: openssl rand -hex 32
OLX_ENCRYPTION_KEY=
